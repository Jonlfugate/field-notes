 "legal": {
  "1": {
   "key": "ok",
   "color": "#2e9d4f",
   "text": "Public land open to hobby hand-collecting for personal use. Follow the manager's limits (BLM: 25 lb + 1 piece/day petrified wood, 250 lb/yr; Forest Service limits vary by forest). No vertebrate fossils or artifacts.",
   "grade": 1
  },
  "2": {
   "key": "check",
   "color": "#e3b505",
   "text": "Public land where collecting rules are unclear or need a permit or licence (state trust lands in ID/MT/OR, wildlife areas, reclamation lands, Alberta). Check with the manager before collecting.",
   "grade": 3
  },
  "3": {
   "key": "claim",
   "color": "#e07a1f",
   "text": "Active or filed mining claim. The claimant holds the mineral rights; get permission before collecting minerals.",
   "grade": 4
  },
  "4": {
   "key": "no",
   "color": "#c0392b",
   "text": "Collecting prohibited: national/state/local parks, national recreation areas (e.g. Lake Roosevelt), wildlife refuges, DOE land, private conservation preserves, BC parks and ecological reserves.",
   "grade": 5
  },
  "5": {
   "key": "tribal",
   "color": "#8e44ad",
   "text": "Tribal reservation or trust land. Collecting needs permission from the tribe (and the owner, for private land inside it).",
   "grade": 4
  },
  "6": {
   "key": "private",
   "color": "#7f8c8d",
   "text": "Private or municipal land. Collecting needs the owner's permission.",
   "grade": 4
  },
  "7": {
   "key": "hazard",
   "color": "#111111",
   "text": "Contamination hazard zone (approximate). Do not collect: heavy-metal or asbestos-contaminated ground.",
   "grade": 5
  },
  "8": {
   "key": "river_open",
   "color": "#2e9d4f",
   "text": "Bed of a large (likely navigable) Idaho river: the state owns the bed below the ordinary high-water mark, and unleased beds are open to casual collecting and recreational mining, first come (IDL, IDAPA 20.03.05). Stay below the high-water line; the bank above it belongs to the landowner.",
   "grade": 1
  },
  "9": {
   "key": "river_grey",
   "color": "#9ccc3d",
   "text": "Bed of a large (likely navigable) Washington river: state-owned aquatic land managed by DNR, not the bank owner. No rule clearly allows or bans hobby collecting here; DNR suggests asking its Mining & Minerals program. Stay below the high-water line; parks and private banks still apply.",
   "grade": 2
  },
  "10": {
   "key": "state_license",
   "color": "#9ccc3d",
   "text": "Montana state trust land (DNRC): open to recreation with legal access and a State Lands recreational use licence; rockhounding is not specifically addressed. Low-key hand collecting is a grey zone: ask DNRC.",
   "grade": 2
  },
  "11": {
   "key": "state_permit",
   "color": "#e3b505",
   "text": "State land where taking rocks likely needs authorization: Idaho endowment land (valuable rocks or minerals need IDL authorization), Oregon state land (DSL permit system for semiprecious stones, petrified wood, fossils), Montana navigable riverbeds (state law requires a lease or licence to use the bed). Ask the agency first.",
   "grade": 3
  },
  "12": {
   "key": "agency_permit",
   "color": "#e07a1f",
   "text": "Agency land where removing rocks is prohibited without a permit: state fish & wildlife areas (Washington: WAC 232-12-251) and Bureau of Reclamation land (43 CFR 423.29). Permits are rarely for hobbyists.",
   "grade": 4
  }
 },
